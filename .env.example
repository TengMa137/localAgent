# Local Agent configuration defaults.
# Copy to .env and change only what you need for local development.

# Web server / auth
LOCALAGENT_STATE_DIR=./localagent_state
# LOCALAGENT_DB_PATH=
LOCALAGENT_WEB_DIR=web
LOCALAGENT_DOCS_DIR=./user_docs
LOCALAGENT_MAX_UPLOAD_BYTES=26214400
LOCALAGENT_SESSION_COOKIE=localagent_session
LOCALAGENT_COOKIE_SECURE=false
LOCALAGENT_SESSION_TTL_SECONDS=604800
LOCALAGENT_ADMIN_USERNAME=
LOCALAGENT_ADMIN_PASSWORD=
LOCALAGENT_MAX_VOICE_AUDIO_BYTES=10485760

# Docker Compose port binding
LOCALAGENT_BIND=127.0.0.1
LOCALAGENT_PORT=8088

# Model endpoint
LOCALAGENT_MODEL_BASE_URL=http://localhost:8080/v1
LOCALAGENT_MODEL_API_KEY=no-key

# Agent runtime
LOCALAGENT_MCP_URL=http://localhost:8000/sse
LOCALAGENT_MEMORY_DIR=.memory
LOCALAGENT_MEMORY_ENABLED=true
# A/B switch for deterministic orchestrator query-policy hints and corrections.
LOCALAGENT_USE_REGEX=true
# Total structured calls: 1 initial attempt + at most 2 retries.
LOCALAGENT_STRUCTURED_OUTPUT_ATTEMPTS=3
LOCALAGENT_STRUCTURED_OUTPUT_MAX_TOKENS=2048
LOCALAGENT_ANSWER_OUTPUT_MAX_TOKENS=4096
# llama.cpp/Qwen extension. Set false for providers that reject chat_template_kwargs.
LOCALAGENT_DISABLE_MODEL_THINKING=true
LOCALAGENT_MODEL_REQUEST_TIMEOUT_SECONDS=180
LOCALAGENT_AGENT_TURN_TIMEOUT_SECONDS=300
LOCALAGENT_SKILLS_DIR=skills
LOCALAGENT_SKILLS_MODE=rw
LOCALAGENT_APPROVE_TOOLS=
LOCALAGENT_MAX_APPROVAL_ROUNDS=3
LOCALAGENT_LOG_LEVEL=
LOCALAGENT_TRACE=

# Speech command fallback, used when an ASR/TTS base URL is empty.
LOCALAGENT_SPEECH_CLI=crispasr

# ASR. Leave BASE_URL set for the CrispASR HTTP server; set it empty for CLI fallback.
LOCALAGENT_ASR_BASE_URL=http://localhost:8081/v1
LOCALAGENT_ASR_BACKEND=qwen3
LOCALAGENT_ASR_MODEL=./models/qwen3-asr-1.7b-q8_0.gguf
LOCALAGENT_ASR_API_KEY=no-key
LOCALAGENT_ASR_TIMEOUT_SECONDS=300
LOCALAGENT_ASR_MAX_TOKENS=512
LOCALAGENT_ASR_TEMPERATURE=0
LOCALAGENT_ASR_RESPONSE_FORMAT=json
LOCALAGENT_ASR_LANGUAGE=
LOCALAGENT_ASR_THREADS=
LOCALAGENT_ASR_VAD=
LOCALAGENT_ASR_OUTPUT_JSON=1

# TTS. Leave BASE_URL set for the CrispASR HTTP server; set it empty for CLI fallback.
LOCALAGENT_TTS_BASE_URL=http://localhost:8082/v1
LOCALAGENT_TTS_CLI=crispasr
LOCALAGENT_TTS_BACKEND=qwen3-tts-customvoice
LOCALAGENT_TTS_MODEL=./models/qwen3-tts-12hz-0.6b-customvoice-q8_0.gguf
LOCALAGENT_TTS_API_KEY=no-key
LOCALAGENT_TTS_TIMEOUT_SECONDS=600
LOCALAGENT_TTS_VOICE=vivian
LOCALAGENT_TTS_VOICE_DIR=
LOCALAGENT_TTS_REF_TEXT=
LOCALAGENT_TTS_CODEC_MODEL=./models/qwen3-tts-tokenizer-12hz.gguf
LOCALAGENT_TTS_LANGUAGE=
LOCALAGENT_TTS_INSTRUCTIONS=
LOCALAGENT_TTS_RESPONSE_FORMAT=wav
LOCALAGENT_TTS_TEMPERATURE=
LOCALAGENT_TTS_SPEED=
LOCALAGENT_TTS_THREADS=

# Terminal TTS playback and chunking.
# These values match the effective Qwen3 terminal profile when no env vars are set.
LOCALAGENT_TTS_PLAYER=
LOCALAGENT_TTS_MIN_CHARS=50
LOCALAGENT_TTS_MAX_CHARS=180
LOCALAGENT_TTS_MIN_SENTENCE_CHARS=24
LOCALAGENT_TTS_INITIAL_MAX_CHARS=120
LOCALAGENT_TTS_PHRASE_BOUNDARY_CHARS=90
